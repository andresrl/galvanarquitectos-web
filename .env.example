NUXT_PUBLIC_SITE_URL=https://galvanarquitectos.com
NUXT_PUBLIC_INDEXABLE=false
NUXT_PUBLIC_SHOW_DRAFTS=false
NUXT_PUBLIC_ANALYTICS_ENABLED=true

# Contact form (server/api/contact.post.ts). Real values only in .env / the server environment, never here.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: inbox for the enquiries (default: GMAIL_USER)
CONTACT_TO=
# Optional: sender name shown in the inbox (default: Web Martínez Galván Arquitecto)
CONTACT_FROM_NAME=
